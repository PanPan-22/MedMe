{
  "expo": {
    "name": "MedMe",
    "slug": "MedMe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/medmeicon.png",
    "scheme": "medme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suphasan.medme",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "MedMe needs access to your local network to communicate with your MedMe Pillbox."
      }
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/medmeicon_foreground.png",
        "backgroundImage": "./assets/images/medmeicon_background.png",
        "monochromeImage": "./assets/images/medmeicon_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suphasan.medme"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/medmeicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#374B3E"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audios/universfield_023.wav",
            "./assets/audios/universfield_029.wav",
            "./assets/audios/universfield_030.wav",
            "./assets/audios/universfield_088.wav",
            "./assets/audios/universfield_091.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MedMe needs access to your photos to set a profile picture."
        }
      ],
      "@clerk/expo",
      "expo-audio",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "MedMe uses Bluetooth to connect to your MedMe Pillbox."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4b47fc8-cadc-4792-958e-661336e54ac3"
      }
    },
    "owner": "suphasan_kh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b4b47fc8-cadc-4792-958e-661336e54ac3"
    }
  }
}
